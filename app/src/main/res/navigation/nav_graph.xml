<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!-- منوی همکار اکسپرس - 4 تب: وینور، پورسانت، روتین، من (هماهنگ با سایت) -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="ir.vinor.app.DashboardFragment"
        android:label="وینور"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/commissionsFragment"
        android:name="ir.vinor.app.CommissionsFragment"
        android:label="پورسانت"
        tools:layout="@layout/fragment_commissions" />

    <fragment
        android:id="@+id/routineFragment"
        android:name="ir.vinor.app.RoutineFragment"
        android:label="روتین"
        tools:layout="@layout/fragment_routine" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="ir.vinor.app.ProfileFragment"
        android:label="من"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_profileEdit"
            app:destination="@id/profileEditFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/loginStep1Fragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/loginStep1Fragment"
        android:name="ir.vinor.app.LoginStep1Fragment"
        android:label="ورود"
        tools:layout="@layout/fragment_login_step1">
        <action
            android:id="@+id/action_loginStep1_to_loginStep2"
            app:destination="@id/loginStep2Fragment"
            app:popUpTo="@id/loginStep1Fragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/loginStep2Fragment"
        android:name="ir.vinor.app.LoginStep2Fragment"
        android:label="کد تأیید"
        tools:layout="@layout/fragment_login_step2">
        <argument
            android:name="phone"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/loginWebFragment"
        android:name="ir.vinor.app.LoginWebFragment"
        android:label="ورود"
        tools:layout="@layout/fragment_webview" />

    <fragment
        android:id="@+id/profileEditFragment"
        android:name="ir.vinor.app.ProfileEditFragment"
        android:label="ویرایش پروفایل"
        tools:layout="@layout/fragment_profile_edit" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="ir.vinor.app.NotificationsFragment"
        android:label="اعلان‌ها"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/notesFragment"
        android:name="ir.vinor.app.NotesFragment"
        android:label="یادداشت‌ها"
        tools:layout="@layout/fragment_notes" />

    <!-- نگه‌داری برای سازگاری با مسیرهای قدیمی (در منو نمایش داده نمی‌شوند) -->
    <fragment
        android:id="@+id/expressFragment"
        android:name="ir.vinor.app.ExploreFragment"
        android:label="اکسپلور"
        tools:layout="@layout/fragment_webview" />

    <fragment
        android:id="@+id/myPropertiesFragment"
        android:name="ir.vinor.app.MyPropertiesFragment"
        android:label="ملک من"
        tools:layout="@layout/fragment_my_property" />

    <fragment
        android:id="@+id/myPropertyFormFragment"
        android:name="ir.vinor.app.MyPropertyFormFragment"
        android:label="ثبت آگهی"
        tools:layout="@layout/fragment_my_property_form">
        <argument
            android:name="publicListing"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/landDetailFragment"
        android:name="ir.vinor.app.LandDetailFragment"
        android:label="فایل"
        tools:layout="@layout/fragment_land_detail">
        <argument
            android:name="code"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nativePartnerFragment"
        android:name="ir.vinor.app.NativePartnerFragment"
        android:label="وینور"
        tools:layout="@layout/fragment_native_partner">
        <argument
            android:name="page"
            app:argType="string"
            android:defaultValue="training" />
    </fragment>

    <fragment
        android:id="@+id/partnerPageFragment"
        android:name="ir.vinor.app.PartnerPageFragment"
        android:label="وینور"
        tools:layout="@layout/fragment_webview">
        <argument
            android:name="url"
            app:argType="string"
            android:defaultValue="https://vinor.ir/express/partner/home" />
    </fragment>

</navigation>
