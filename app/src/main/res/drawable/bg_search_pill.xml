<?xml version="1.0" encoding="utf-8"?>
<!-- قرص یکپارچهٔ جستجوی خانه (سبک دیوار): ذره‌بین، ورودی، جداکننده و شهر داخل یک کپسول. هم‌تراز با .vn-search-field وب. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vinor_raised" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="@color/vinor_border_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vinor_raised" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
