<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_routine_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/requestCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/vinor_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/requestCardMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/vinor_text_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/requestCardActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />
</LinearLayout>
