<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp">

    <FrameLayout
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_marginBottom="36dp">

        <View
            android:id="@+id/onboardIconBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_onboard_icon_brand" />

        <ImageView
            android:id="@+id/onboardIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:contentDescription="" />
    </FrameLayout>

    <TextView
        android:id="@+id/onboardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/onboardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:lineSpacingMultiplier="1.45"
        android:textColor="#8E8E93"
        android:textSize="16sp" />
</LinearLayout>
