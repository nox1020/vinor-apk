<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinor_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- همان نوار بالای «مشتریان» / «پیگیری»: 56dp، پس‌زمینه chrome، خط ۱dp. -->
    <LinearLayout
        android:id="@+id/profileEditHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vinor_chrome"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/profileEditBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="بازگشت"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/vinor_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="ویرایش پروفایل"
            android:textColor="@color/vinor_text"
            android:textSize="17sp" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vinor_border" />

    <ProgressBar
        android:id="@+id/profileEditProgress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/profileEditScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/profileEditAvatarTrigger"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:clickable="true"
                    android:contentDescription="تغییر عکس پروفایل"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/profileEditAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription=""
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profileEditInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:gravity="center"
                        android:textColor="@color/vinor_text_muted"
                        android:textSize="24sp" />

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/bg_avatar_camera_badge">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="📷"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/profileEditAvatarUploading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#80000000"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/vazirmatn"
                    android:gravity="center"
                    android:maxWidth="280dp"
                    android:text="برای تغییر عکس، روی تصویر بزنید"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pe_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="نام و نام خانوادگی"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/profileEditName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/vazirmatn"
                    android:hint="نام و نام خانوادگی"
                    android:inputType="textPersonName"
                    android:maxLength="60"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/vinor_text"
                    android:textColorHint="#6B7280"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/vinor_border" />

                <TextView
                    android:id="@+id/profileEditNameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="نام را وارد کنید"
                    android:textColor="#FB7185"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="شماره موبایل"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/profileEditPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text_muted"
                    android:textDirection="ltr"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/vinor_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="شماره موبایل قابل تغییر نیست"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="شهر فعالیت"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/profileEditCity"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/vinor_border" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pe_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="درباره من (اختیاری)"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/profileEditBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/vazirmatn"
                    android:gravity="top|start"
                    android:hint="چند خط درباره خودتان…"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="200"
                    android:minLines="3"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/vinor_text"
                    android:textColorHint="#6B7280"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/vinor_border" />

                <TextView
                    android:id="@+id/profileEditBioCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="0/200"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/profileEditSaveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vinor_bg"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/profileEditSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pe_save"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingVertical="12dp"
            android:text="ذخیره تغییرات"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/profileEditCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="انصراف"
            android:textColor="@color/vinor_text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
