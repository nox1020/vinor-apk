<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_routine_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/customerDetailAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_hub_avatar"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:textColor="@color/vinor_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/customerDetailName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/vazirmatn_bold"
            android:textColor="@color/vinor_text"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/customerDetailFacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_routine_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />
</LinearLayout>
