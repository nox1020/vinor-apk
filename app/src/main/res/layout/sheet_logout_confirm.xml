<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_sheet"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/logoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn_bold"
        android:gravity="start"
        android:text="خروج از حساب؟"
        android:textColor="@color/vinor_text"
        android:textSize="15sp" />

    <FrameLayout
        android:id="@+id/logoutConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_apply"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/logoutConfirmLabel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:text="خروج"
            android:textColor="@color/vinor_on_primary"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/logoutConfirmProgress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/vinor_on_primary"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/logoutCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_logout_outline"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/vazirmatn_bold"
        android:gravity="center"
        android:text="انصراف"
        android:textColor="@color/vinor_text"
        android:textSize="15sp" />
</LinearLayout>
