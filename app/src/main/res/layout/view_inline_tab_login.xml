<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/vinor_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/inlineLoginTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:text="ورود به وینور"
            android:textSize="22sp"
            android:textColor="@color/vinor_text" />
        <TextView
            android:id="@+id/inlineLoginLead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/vinor_text_muted"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/inlineLoginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/vinor_error"
            android:textSize="13sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/inlinePhoneStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">
            <EditText
                android:id="@+id/inlineLoginPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_input"
                android:hint="شماره موبایل (09123456789)"
                android:inputType="phone"
                android:gravity="center"
                android:layoutDirection="ltr"
                android:maxLength="11"
                android:paddingHorizontal="12dp"
                android:textColor="@color/vinor_text"
                android:textColorHint="@color/vinor_text_muted" />
            <TextView
                android:id="@+id/inlineLoginLegal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="با ورود، قوانین و حریم خصوصی وینور را می‌پذیرید."
                android:textColor="@color/vinor_text_muted"
                android:textSize="12sp" />
            <Button
                android:id="@+id/inlineLoginSend"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/vinor_accent_green"
                android:textColor="@color/vinor_on_primary"
                android:text="دریافت کد تأیید" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/inlineOtpStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">
            <EditText
                android:id="@+id/inlineLoginCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_input"
                android:hint="کد پیامک‌شده"
                android:inputType="number"
                android:gravity="center"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:textColor="@color/vinor_text"
                android:textColorHint="@color/vinor_text_muted" />
            <Button
                android:id="@+id/inlineLoginVerify"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/vinor_accent_green"
                android:textColor="@color/vinor_on_primary"
                android:text="تأیید و ورود" />
            <Button
                android:id="@+id/inlineLoginResend"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="ارسال مجدد کد" />
            <Button
                android:id="@+id/inlineLoginChange"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="تغییر شماره موبایل" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/inlineLoginProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
