<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemCommissionLandCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="کد فایل: —"
                android:textColor="@color/vinor_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemCommissionDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/vinor_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/itemCommissionSaleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مبلغ فروش"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/itemCommissionSaleAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/vinor_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemCommissionAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="۰ تومان"
                android:textColor="@color/vinor_accent_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemCommissionPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:text="0%"
                android:textColor="@color/vinor_text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/itemCommissionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_routine_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="در انتظار"
                android:textColor="#D97706"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:background="@color/vinor_border" />
</LinearLayout>
