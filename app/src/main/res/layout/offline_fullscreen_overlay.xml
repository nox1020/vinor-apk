<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offlineContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinor_offline_bg"
    android:clickable="true"
    android:elevation="28dp"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/offlineTapArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.9"
            android:contentDescription="@string/offline_icon_cd"
            android:src="@drawable/ic_wifi_off" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textColor="@color/vinor_offline_text_primary"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_message"
            android:textColor="@color/vinor_offline_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/vinor_offline_btn"
            android:minHeight="44dp"
            android:minWidth="148dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/offline_retry"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <ProgressBar
            android:id="@+id/retryProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/vinor_offline_btn"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
