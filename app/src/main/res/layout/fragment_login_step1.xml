<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vinor_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <ImageButton
            android:id="@+id/loginStep1Back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="بستن"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@color/vinor_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تأیید شماره موبایل"
            android:textColor="@color/vinor_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="شماره موبایل خود را وارد کنید"
                android:textColor="@color/vinor_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="کد تأیید به این شماره پیامک می‌شود."
                android:textColor="@color/vinor_text_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/loginStep1Phone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_auth_input"
                android:hint="شماره موبایل"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLength="11"
                android:paddingHorizontal="16dp"
                android:textColor="@color/vinor_text"
                android:textColorHint="@color/vinor_text_muted"
                android:textDirection="ltr"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/loginStep1Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/vinor_error"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="3dp"
                android:text="با ورود به وینور اکسپرس، شرایط و قوانین استفاده و سیاست‌نامه حریم خصوصی را می‌پذیرم."
                android:textColor="@color/vinor_text_muted"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/loginStep1Progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/loginStep1Submit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_hub_start"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="بعدی"
        android:textColor="#052E16"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
