<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_sheet"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/followConfirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/vazirmatn_bold"
        android:textColor="@color/vinor_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/followConfirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/vazirmatn"
        android:textColor="@color/vinor_text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/followConfirmReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_flat_outline_card"
        android:fontFamily="@font/vazirmatn"
        android:hint="دلیل اعتراض"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/vinor_text"
        android:textColorHint="@color/vinor_text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/followConfirmYes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/vazirmatn_bold"
        android:gravity="center"
        android:textColor="@color/vinor_error"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/followConfirmNo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:text="انصراف"
        android:textColor="@color/vinor_text"
        android:textSize="15sp" />
</LinearLayout>
