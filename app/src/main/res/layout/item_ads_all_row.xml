<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_row"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="128dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- wrap_content + minHeight: price stays at the bottom for short titles,
             and the row grows for two-line titles instead of clipping the place line. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:minHeight="104dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/adsAllTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn_bold"
                android:lineSpacingMultiplier="1.5"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/vinor_text"
                android:textDirection="rtl"
                android:textSize="15sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="8dp" />

            <LinearLayout
                android:id="@+id/adsAllMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/adsAllPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text"
                    android:textDirection="rtl"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/adsAllComm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_accent_green"
                    android:textDirection="rtl"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/adsAllArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text_muted"
                    android:textDirection="rtl"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/adsAllLoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/vazirmatn"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text_muted"
                    android:textDirection="rtl"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/adsAllThumbWrap"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@color/vinor_raised_2">

            <ImageView
                android:id="@+id/adsAllPlaceholder"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription=""
                android:importantForAccessibility="no"
                android:src="@drawable/ic_photo_placeholder" />

            <ImageView
                android:id="@+id/adsAllThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription=""
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/adsAllShots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:layout_margin="4dp"
                android:background="@drawable/bg_search_badge"
                android:drawablePadding="2dp"
                android:fontFamily="@font/vazirmatn_bold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:paddingHorizontal="4dp"
                android:textColor="@color/vinor_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/adsAllDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="132dp"
        android:background="@color/vinor_border" />
</LinearLayout>
