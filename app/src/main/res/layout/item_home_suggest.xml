<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_flat_outline_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/suggestImage"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/vinor_skeleton_bg"
        android:contentDescription=""
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/suggestTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:textColor="@color/vinor_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/suggestSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingBottom="6dp"
        android:textColor="@color/vinor_text_muted"
        android:textSize="11sp" />
</LinearLayout>
