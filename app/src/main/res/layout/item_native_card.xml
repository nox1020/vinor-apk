<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_routine_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/nativeCardKicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/vinor_accent_green"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nativeCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/vinor_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nativeCardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.45"
        android:textColor="@color/vinor_text_muted"
        android:textSize="14sp" />
</LinearLayout>
