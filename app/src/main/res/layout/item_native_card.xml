<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_routine_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/nativeCardKicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#6EE7B7"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nativeCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nativeCardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.45"
        android:textColor="#A1A1AA"
        android:textSize="13sp" />
</LinearLayout>
