<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinor_bg"
    android:layoutDirection="rtl">

    <ScrollView
        android:id="@+id/landDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="112dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/landDetailGallery"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layoutDirection="ltr" />

                <ImageView
                    android:id="@+id/landDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/vinor_raised_2"
                    android:contentDescription=""
                    android:scaleType="center"
                    android:src="@drawable/ic_photo_placeholder"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="12dp">

                    <TextView
                        android:id="@+id/landDetailBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ld_orb"
                        android:fontFamily="@font/vazirmatn"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/vinor_text"
                        android:textSize="22sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/landDetailShare"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_ld_orb"
                        android:contentDescription="اشتراک‌گذاری"
                        android:padding="11dp"
                        android:src="@drawable/ic_share_nodes"
                        android:tint="@color/vinor_text" />

                    <ImageButton
                        android:id="@+id/landDetailFav"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ld_orb"
                        android:contentDescription="نشان"
                        android:padding="11dp"
                        android:src="@drawable/ic_bookmark"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/landDetailCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_ld_counter"
                    android:fontFamily="@font/vazirmatn"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/vinor_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <ProgressBar
                android:id="@+id/landDetailProgress"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/vinor_text_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ld_badge"
                android:fontFamily="@font/vazirmatn"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/vinor_text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/vazirmatn"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/vinor_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/landDetailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/vinor_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/landDetailCommission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/vinor_accent_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/vinor_text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/vinor_text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/landDetailFactsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/landDetailFacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/landDetailSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/vazirmatn"
                android:text="ویژگی‌ها"
                android:textColor="@color/vinor_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/landDetailRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_ld_surface"
                android:divider="@drawable/div_search_row"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:showDividers="middle"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailDescLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/vazirmatn"
                android:text="توضیحات"
                android:textColor="@color/vinor_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/vazirmatn"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/vinor_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/landDetailMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/vazirmatn"
                android:paddingVertical="2dp"
                android:text="نمایش بیشتر"
                android:textColor="@color/vinor_accent_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/landDetailPublish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_ld_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/landDetailPublishTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/vazirmatn"
                    android:text="انتشار برای فروش"
                    android:textColor="@color/vinor_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/landDetailPublishHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/vazirmatn"
                    android:text="بعد از انتشار، این ملک در آگهی‌های وینور دیده می‌شود."
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/landDetailPayRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/landDetailPayCash"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ld_chip"
                        android:fontFamily="@font/vazirmatn"
                        android:gravity="center"
                        android:text="نقدی"
                        android:textColor="@color/vinor_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/landDetailPayDeal"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ld_chip"
                        android:fontFamily="@font/vazirmatn"
                        android:gravity="center"
                        android:text="توافقی"
                        android:textColor="@color/vinor_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/landDetailPaySwap"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ld_chip"
                        android:fontFamily="@font/vazirmatn"
                        android:gravity="center"
                        android:text="معاوضه"
                        android:textColor="@color/vinor_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/landDetailCommissionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn"
                        android:text="پورسانت"
                        android:textColor="@color/vinor_text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/landDetailCommissionPct"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ld_chip"
                        android:fontFamily="@font/vazirmatn"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:text="2"
                        android:textColor="@color/vinor_text"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/vazirmatn"
                        android:text="٪"
                        android:textColor="@color/vinor_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/landDetailSendAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:buttonTint="@color/vinor_accent_green"
                    android:fontFamily="@font/vazirmatn"
                    android:text="ارسال به همه همکاران"
                    android:textColor="@color/vinor_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/landDetailPublishCta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_hub_start"
                    android:fontFamily="@font/vazirmatn"
                    android:gravity="center"
                    android:text="انتشار برای فروش"
                    android:textColor="@color/vinor_customer_bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/landDetailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/vinor_primary_red"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/landDetailSticky"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/vinor_chrome"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/landDetailStickyPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:maxLines="1"
                android:textColor="@color/vinor_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/landDetailStickyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/vazirmatn"
                android:textColor="@color/vinor_text_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/landDetailVisit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_flat_outline_card"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:minWidth="88dp"
            android:paddingHorizontal="14dp"
            android:text="بازدید"
            android:textColor="@color/vinor_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/landDetailDivar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_hub_start"
            android:fontFamily="@font/vazirmatn"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingHorizontal="14dp"
            android:text="گفتگو"
            android:textColor="@color/vinor_customer_bg"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
