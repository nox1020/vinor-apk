<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vinor_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/landDetailBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_orb"
            android:gravity="center"
            android:text="‹"
            android:textColor="#ECECEC"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_header_title_pill"
            android:gravity="center"
            android:text="جزئیات آگهی"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/landDetailFav"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_orb"
            android:contentDescription="نشان"
            android:padding="11dp"
            android:src="@drawable/ic_bookmark" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/landDetailProgress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/landDetailImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#1A2332"
                android:contentDescription=""
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/landDetailBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_header_title_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="دیوار"
                android:textColor="#BAE6FD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/landDetailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:textColor="#94A3B8"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/landDetailCommission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/landDetailRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/landDetailBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#E4E4E7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/landDetailDivar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_header_title_pill"
                android:gravity="center"
                android:padding="14dp"
                android:text="دیدن در دیوار"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/landDetailPublish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_routine_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/landDetailPublishTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="انتشار برای فروش"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/landDetailPublishHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="بعد از انتشار، این ملک در آگهی‌های وینور دیده می‌شود."
                    android:textColor="#A7F3D0"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/landDetailPayRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/landDetailPayCash"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="نقدی"
                        android:textColor="#052E16"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/landDetailPayDeal"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="توافقی"
                        android:textColor="#ECECEC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/landDetailPaySwap"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="معاوضه"
                        android:textColor="#ECECEC"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/landDetailCommissionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="پورسانت"
                        android:textColor="#D1D5DB"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/landDetailCommissionPct"
                        android:layout_width="72dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_routine_card"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="٪"
                        android:textColor="#D1D5DB"
                        android:textSize="13sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/landDetailSendAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:buttonTint="#10B981"
                    android:text="ارسال به همه همکاران"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/landDetailPublishCta"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_mp_submit"
                    android:gravity="center"
                    android:text="انتشار برای فروش"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/landDetailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:textColor="#F87171"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
