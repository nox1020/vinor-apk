<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vinor_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/landDetailBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_orb"
            android:gravity="center"
            android:text="‹"
            android:textColor="#ECECEC"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_header_title_pill"
            android:gravity="center"
            android:text="جزئیات فایل"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/landDetailFav"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_header_orb"
            android:contentDescription="نشان"
            android:padding="11dp"
            android:src="@drawable/ic_bookmark" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/landDetailProgress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/landDetailImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#1A2332"
                android:contentDescription=""
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/landDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/landDetailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:textColor="#94A3B8"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/landDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/landDetailBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#E4E4E7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/landDetailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:textColor="#F87171"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
