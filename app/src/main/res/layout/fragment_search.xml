<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinor_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <TextView
        android:id="@+id/searchTitle"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_header_title_pill"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:text="جستجو"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_drawer_input"
        android:drawableStart="@drawable/ic_search_stroke"
        android:drawablePadding="8dp"
        android:fontFamily="@font/vazirmatn"
        android:hint="جستجوی ملک، محله یا قیمت"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textAlignment="viewStart"
        android:textColor="@color/vinor_text"
        android:textColorHint="#8E8E93"
        android:textDirection="rtl"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/searchProgress"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:indeterminateTint="#8E8E93"
        android:visibility="gone" />

    <TextView
        android:id="@+id/searchEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:text="ملکی برای نمایش نیست."
        android:textColor="#71717A"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/searchRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/searchScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/searchList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/div_search_row"
                android:orientation="vertical"
                android:showDividers="middle" />
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
