<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vinor_chrome"
    android:clipChildren="false"
    android:elevation="8dp"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vinor_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabAds"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:clickable="true"
            android:contentDescription="آگهی‌ها"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/tabAdsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_home"
                    app:tint="@color/vinor_nav_selected" />
            </FrameLayout>

            <TextView
                android:id="@+id/tabAdsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="آگهی‌ها"
                android:textColor="@color/vinor_nav_selected"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:clickable="true"
            android:contentDescription="جستجو"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/tabSearchIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_tab_search"
                    app:tint="@color/vinor_nav_unselected" />
            </FrameLayout>

            <TextView
                android:id="@+id/tabSearchLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="جستجو"
                android:textColor="@color/vinor_nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:clickable="true"
            android:contentDescription="ثبت آگهی"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/tabPostIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_tab_add"
                    app:tint="@color/vinor_nav_unselected" />
            </FrameLayout>

            <TextView
                android:id="@+id/tabPostLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="ثبت آگهی"
                android:textColor="@color/vinor_nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:clickable="true"
            android:contentDescription="AI چت"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/tabChatIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_tab_chat"
                    app:tint="@color/vinor_nav_unselected" />

                <TextView
                    android:id="@+id/tabChatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_divar_chat_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="14dp"
                    android:paddingHorizontal="3dp"
                    android:textColor="@color/vinor_on_primary"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tabChatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="AI چت"
                android:textColor="@color/vinor_nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabMe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:clickable="true"
            android:contentDescription="وینور من"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="2dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/tabMeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription=""
                    android:src="@drawable/ic_tab_me"
                    app:tint="@color/vinor_nav_unselected" />
            </FrameLayout>

            <TextView
                android:id="@+id/tabMeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/vazirmatn"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="وینور من"
                android:textColor="@color/vinor_nav_unselected"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
