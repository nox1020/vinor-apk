<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <TextView
        android:id="@+id/onboardSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:fontFamily="@font/vazirmatn"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/onboard_skip"
        android:textColor="#8E8E93"
        android:textSize="15sp" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboardPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never" />

    <LinearLayout
        android:id="@+id/onboardDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/onboardNext"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_onboard_cta"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:text="@string/onboard_next"
        android:textColor="#111111"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
