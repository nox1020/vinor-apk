<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_sheet"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="حذف آگهی"
        android:textColor="@color/vinor_text"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/vazirmatn"
        android:text="این آگهی از فهرست شما برداشته می‌شود."
        android:textColor="@color/vinor_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/deleteSheetConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/vazirmatn_bold"
        android:gravity="center"
        android:text="حذف آگهی"
        android:textColor="@color/vinor_error"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/deleteSheetCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/vazirmatn"
        android:gravity="center"
        android:text="انصراف"
        android:textColor="@color/vinor_text"
        android:textSize="15sp" />
</LinearLayout>
