<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinor_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/offlineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1C1C1E"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/offline_message_cached"
            android:textColor="@color/vinor_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostFragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#000000"
            android:visibility="gone"
            app:elevation="0dp"
            app:itemIconTint="@color/bottom_nav_color"
            app:itemTextColor="@color/bottom_nav_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>

    <View
        android:id="@+id/drawerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#000000"
        android:clickable="true"
        android:elevation="16dp"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:paddingHorizontal="18dp"
            android:text="وینور"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingHorizontal="18dp"
            android:text="گفتگو"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/drawerVinorChat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_drawer_chip"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:text="✦  وینور"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#14FFFFFF" />

        <TextView
            android:id="@+id/drawerTraining"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="آموزش"
            android:textColor="#ECECEC"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/drawerRoutine"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="پیگیری"
            android:textColor="#ECECEC"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/drawerWallet"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="کیف پول"
            android:textColor="#ECECEC"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/drawerProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="پروفایل"
            android:textColor="#ECECEC"
            android:textSize="16sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/drawerGuestLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/drawerPhoneStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ورود به وینور"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="شماره موبایل را وارد کنید؛ کد تأیید پیامک می‌شود."
                    android:textColor="#8E8E93"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/drawerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_drawer_input"
                    android:hint="09xxxxxxxxx"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#47FFFFFF"
                    android:textDirection="ltr"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/drawerLoginHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FDA4AF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="با ادامه، شرایط و حریم خصوصی را می‌پذیرید."
                    android:textColor="#8E8E93"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/drawerLoginSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.45"
                    android:background="@drawable/bg_drawer_login_btn"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="ادامه"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawerOtpStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="کد تأیید"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/drawerOtpPhoneLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#A1A1AA"
                        android:textDirection="ltr"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/drawerChangePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="تغییر شماره"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/drawerOtp"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_drawer_input"
                    android:gravity="center"
                    android:hint="-----"
                    android:inputType="number"
                    android:letterSpacing="0.28"
                    android:maxLength="5"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#47FFFFFF"
                    android:textDirection="ltr"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawerOtpHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FDA4AF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/drawerOtpSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.45"
                    android:background="@drawable/bg_drawer_login_btn"
                    android:enabled="false"
                    android:gravity="center"
                    android:text="ورود"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
