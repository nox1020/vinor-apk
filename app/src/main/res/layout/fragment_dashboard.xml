<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vinor_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/dashboardRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/dashboardScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <HorizontalScrollView
                    android:id="@+id/dashboardAdsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:layoutDirection="rtl"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/dashboardAds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal"
                        android:paddingTop="48dp"
                        android:paddingBottom="8dp" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/dashboardEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="6dp">

                    <LinearLayout
                        android:id="@+id/dashboardNews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_news"
                        android:gravity="center_vertical"
                        android:layoutDirection="rtl"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp">

                        <View
                            android:id="@+id/dashboardNewsDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_news_dot" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="خبر وینور"
                                android:textColor="#6EE7B7"
                                android:letterSpacing="0.04"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/dashboardNewsText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="زمین جابان فروش رفت و پورسانت رسید"
                                android:textColor="#ECECEC"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dashboardHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_home_hero"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="14dp">

                        <ImageView
                            android:id="@+id/dashboardHeroIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription=""
                            android:src="@drawable/ic_handshake" />

                        <TextView
                            android:id="@+id/dashboardHeroTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="می‌خواهم بازاریاب وینور شوم"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dashboardHeroSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="شروع همکاری فروش و دریافت پورسانت"
                            android:textColor="#C7E4E4E7"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="⌄"
                            android:textColor="#F4F4F5"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dashboardTiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="6dp">

                        <LinearLayout
                            android:id="@+id/dashboardTileBuy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/dashboardTileBuyIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginTop="2dp"
                                android:contentDescription=""
                                android:src="@drawable/ic_search_stroke" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/dashboardTileBuyTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="خرید ملک"
                                        android:textColor="#F4F4F5"
                                        android:textSize="14.5sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/dashboardTileBuyCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:background="@drawable/bg_count_badge"
                                        android:minWidth="19dp"
                                        android:paddingHorizontal="5dp"
                                        android:paddingVertical="2dp"
                                        android:textColor="#FFFFFF"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/dashboardTileBuySub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="جستجوی فایل و ملک"
                                    android:textColor="#8E8E93"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="36dp"
                            android:background="#1FFFFFFF" />

                        <LinearLayout
                            android:id="@+id/dashboardTileLevels"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/dashboardTileLevelsIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginTop="2dp"
                                android:contentDescription=""
                                android:src="@drawable/ic_users_stroke" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/dashboardTileLevelsTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="سطوح همکاری"
                                        android:textColor="#F4F4F5"
                                        android:textSize="14.5sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/dashboardTileLevelsCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:background="@drawable/bg_count_badge"
                                        android:minWidth="19dp"
                                        android:paddingHorizontal="5dp"
                                        android:paddingVertical="2dp"
                                        android:textColor="#FFFFFF"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:visibility="gone" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/dashboardTileLevelsSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="شرایط و پورسانت"
                                    android:textColor="#8E8E93"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dashboardChatList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layoutDirection="rtl"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="8dp" />
            </LinearLayout>
        </ScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <View
                android:id="@+id/dashboardAttachScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#7A000000"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/dashboardComposer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/dashboardAttachSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:background="@drawable/bg_attach_sheet"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="10dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                android:layout_marginBottom="5dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/dashboardAttachGallery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="51dp"
                        android:layout_height="51dp"
                        android:background="@drawable/bg_attach_icon_gallery"
                        android:contentDescription=""
                        android:padding="14dp"
                        android:src="@drawable/ic_attach_gallery" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="گالری"
                        android:textColor="#C4C4C4"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dashboardAttachCamera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="51dp"
                        android:layout_height="51dp"
                        android:background="@drawable/bg_attach_icon_camera"
                        android:contentDescription=""
                        android:padding="14dp"
                        android:src="@drawable/ic_attach_camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="دوربین"
                        android:textColor="#C4C4C4"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dashboardAttachVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="51dp"
                        android:layout_height="51dp"
                        android:background="@drawable/bg_attach_icon_video"
                        android:contentDescription=""
                        android:padding="14dp"
                        android:src="@drawable/ic_attach_video" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="ویدیو"
                        android:textColor="#C4C4C4"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dashboardAttachFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="51dp"
                        android:layout_height="51dp"
                        android:background="@drawable/bg_attach_icon_file"
                        android:contentDescription=""
                        android:padding="14dp"
                        android:src="@drawable/ic_attach_file" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="فایل"
                        android:textColor="#C4C4C4"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dashboardAttachPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:background="@drawable/bg_attach_preview"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="7dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/dashboardAttachThumb"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_attach_thumb"
                    android:contentDescription=""
                    android:padding="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_attach_file" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dashboardAttachName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#F4F4F5"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dashboardAttachSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#A1A1AA"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/dashboardAttachRemove"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_circle_muted"
                    android:contentDescription="حذف پیوست"
                    android:padding="7dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_composer_pill"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:minHeight="54dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <ImageButton
                    android:id="@+id/dashboardChatPlus"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="افزودن"
                    android:padding="8dp"
                    android:src="@drawable/ic_add"
                    app:tint="#ECECEC" />

                <EditText
                    android:id="@+id/dashboardChatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="از وینور بپرس"
                    android:imeOptions="actionSend"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minHeight="40dp"
                    android:paddingHorizontal="6dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text"
                    android:textColorHint="#8F8F8F"
                    android:textDirection="rtl"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/dashboardChatSend"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_send_idle"
                    android:contentDescription="ارسال"
                    android:padding="8dp"
                    android:src="@drawable/ic_send_up"
                    app:tint="#111111" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/dashboardBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="-0.02"
            android:text="وینور"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/dashboardMenu"
            android:layout_width="41dp"
            android:layout_height="41dp"
            android:background="@drawable/bg_menu_orb"
            android:contentDescription="منو"
            android:padding="11dp"
            android:src="@drawable/ic_menu_stroke"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dashboardProgress"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:indeterminateTint="#8E8E93"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/dashboardAdsAll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/dashboardAdsAllBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B8000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:layout_marginTop="80dp"
            android:background="@drawable/bg_ads_all_panel"
            android:clickable="true"
            android:orientation="vertical">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:background="#33FFFFFF" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="آگهی‌ها"
                    android:textColor="#F4F4F5"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/dashboardAdsAllClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="بستن"
                    android:padding="8dp"
                    android:src="@drawable/ic_close" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#14FFFFFF" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/dashboardAdsAllList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/dashboardCustomer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/dashboardCustomerBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B8000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_customer_panel"
            android:clickable="true"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:background="#33FFFFFF" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="ثبت مشتری جدید"
                    android:textColor="#F4F4F5"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/dashboardCustomerClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="بستن"
                    android:padding="8dp"
                    android:src="@drawable/ic_close" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#14FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <EditText
                    android:id="@+id/dashboardCustomerFirst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_drawer_input"
                    android:hint="نام"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text"
                    android:textColorHint="#8E8E93"
                    android:textDirection="rtl"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/dashboardCustomerLast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_drawer_input"
                    android:hint="نام خانوادگی"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text"
                    android:textColorHint="#8E8E93"
                    android:textDirection="rtl"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/dashboardCustomerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_drawer_input"
                    android:hint="0912…"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text"
                    android:textColorHint="#8E8E93"
                    android:textDirection="ltr"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/dashboardCustomerNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_drawer_input"
                    android:gravity="top|start"
                    android:hint="مثلاً ترجیح منطقه یا نکتهٔ مهم برای بازدید"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/vinor_text"
                    android:textColorHint="#8E8E93"
                    android:textDirection="rtl"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/dashboardCustomerSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_customer_submit"
                    android:text="ارسال درخواست تعیین وقت بازدید"
                    android:textColor="#042F2E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
