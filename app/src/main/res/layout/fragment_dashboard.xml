<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vinor_bg_dark"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="وینور"
            android:textColor="#F9FAFB"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/dashboardLoginChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="ورود"
            android:textColor="#F9FAFB"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/dashboardTotalCommission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_routine_card"
            android:padding="10dp"
            android:text="درآمد: ۰"
            android:textColor="#4ADE80"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/dashboardPendingCommission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_routine_card"
            android:padding="10dp"
            android:text="در انتظار: ۰"
            android:textColor="#FCD34D"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/dashboardSoldCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_routine_card"
            android:padding="10dp"
            android:text="فروش: ۰"
            android:textColor="#93C5FD"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dashboardProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">
            <LinearLayout
                android:id="@+id/dashboardChatList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/dashboardLandsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="فایل‌ها"
                android:textColor="#F9FAFB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/dashboardLandList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <FrameLayout
                android:id="@+id/dashboardEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_routine_card"
                android:padding="24dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/dashboardEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="برای شروع گفتگو وارد شوید."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/dashboardComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111827"
        android:gravity="center_vertical"
        android:padding="10dp">
        <EditText
            android:id="@+id/dashboardChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_routine_card"
            android:hint="پیام به وینور..."
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:padding="10dp"
            android:textColor="#F9FAFB"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/dashboardChatSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="ارسال"
            android:textColor="#F9FAFB"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
