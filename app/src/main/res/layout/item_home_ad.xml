<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_hub_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="148dp">

        <ImageView
            android:id="@+id/homeAdImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A2332"
            android:contentDescription=""
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/homeAdWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_loc_chip"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="120dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeAdLoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_loc_chip"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="180dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/homeAdShots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="#8C000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:contentDescription=""
                android:src="@drawable/ic_camera_small" />

            <TextView
                android:id="@+id/homeAdShotsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/homeAdTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#F4F4F5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeAdArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeAdPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#E4E4E7"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeAdComm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#4ADE80"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeAdIntro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hub_start"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="معرفی به مشتری"
                android:textColor="#052E16"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeAdCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hub_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="44dp"
                android:text="تماس"
                android:textColor="#FAFAFA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
