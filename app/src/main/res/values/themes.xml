<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vinor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:textViewStyle">@style/Widget.Vinor.TextView</item>
        <item name="android:editTextStyle">@style/Widget.Vinor.EditText</item>
        <item name="editTextStyle">@style/Widget.Vinor.EditText</item>
        <item name="android:buttonStyle">@style/Widget.Vinor.Button</item>
        <item name="buttonStyle">@style/Widget.Vinor.Button</item>
        <item name="android:textAppearance">@style/TextAppearance.Vinor</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Vinor</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Vinor</item>
        <item name="textAppearanceButton">@style/TextAppearance.Vinor</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Vinor</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.Vinor</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Vinor</item>
        <item name="android:windowBackground">@color/vinor_bg</item>
        <item name="android:colorBackground">@color/vinor_bg</item>
        <item name="android:navigationBarColor">@color/vinor_chrome</item>
        <item name="android:statusBarColor">@color/vinor_chrome</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <!-- بدون نوار اسکرول در کل اپ (هم‌ارز CSS وب). اسکرول کار می‌کند؛ فقط نوار رسم نمی‌شود. -->
        <item name="android:scrollbars">none</item>
        <item name="android:scrollbarThumbVertical">@android:color/transparent</item>
        <item name="android:scrollbarThumbHorizontal">@android:color/transparent</item>
        <item name="android:scrollbarTrackVertical">@android:color/transparent</item>
        <item name="android:scrollbarTrackHorizontal">@android:color/transparent</item>
        <item name="android:scrollViewStyle">@style/Widget.Vinor.ScrollView</item>
        <item name="android:horizontalScrollViewStyle">@style/Widget.Vinor.HorizontalScrollView</item>
        <item name="android:listViewStyle">@style/Widget.Vinor.ListView</item>
        <item name="android:gridViewStyle">@style/Widget.Vinor.GridView</item>
        <item name="android:webViewStyle">@style/Widget.Vinor.WebView</item>
        <item name="recyclerViewStyle">@style/Widget.Vinor.RecyclerView</item>
        <item name="nestedScrollViewStyle">@style/Widget.Vinor.NestedScrollView</item>
    </style>

    <!-- دیالوگ‌های تمام‌صفحهٔ کدی (کیف پول، برداشت، فروخته شد) — همان DeviceDefault بدون نوار اسکرول -->
    <style name="Theme.Vinor.FullScreenDialog" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- بدون نوار اسکرول در کل اپ (هم‌ارز CSS وب). اسکرول کار می‌کند؛ فقط نوار رسم نمی‌شود. -->
        <item name="android:scrollbars">none</item>
        <item name="android:scrollbarThumbVertical">@android:color/transparent</item>
        <item name="android:scrollbarThumbHorizontal">@android:color/transparent</item>
        <item name="android:scrollbarTrackVertical">@android:color/transparent</item>
        <item name="android:scrollbarTrackHorizontal">@android:color/transparent</item>
        <item name="android:scrollViewStyle">@style/Widget.Vinor.ScrollView</item>
        <item name="android:horizontalScrollViewStyle">@style/Widget.Vinor.HorizontalScrollView</item>
        <item name="android:listViewStyle">@style/Widget.Vinor.ListView</item>
        <item name="android:gridViewStyle">@style/Widget.Vinor.GridView</item>
        <item name="android:webViewStyle">@style/Widget.Vinor.WebView</item>
        <item name="recyclerViewStyle">@style/Widget.Vinor.RecyclerView</item>
        <item name="nestedScrollViewStyle">@style/Widget.Vinor.NestedScrollView</item>
    </style>

    <!-- Splash — پس‌زمینه تیره + لوگوی وکتور تیز -->
    <style name="Theme.Vinor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vinor_bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vinor_splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/vinor_bg_dark</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Vinor</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/vinor_bg_dark</item>
        <item name="android:navigationBarColor">@color/vinor_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:scrollbars">none</item>
    </style>
</resources>
