<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vinor" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/vinor_bg_dark</item>
        <item name="android:colorBackground">@color/vinor_bg_dark</item>
        <item name="android:navigationBarColor">@color/vinor_bg_dark</item>
        <item name="android:statusBarColor">@color/vinor_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Splash — هماهنگ با express-partner.webmanifest (background #030712 + icon-192) -->
    <style name="Theme.Vinor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vinor_pwa_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_pwa_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Vinor</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/vinor_pwa_bg</item>
        <item name="android:navigationBarColor">@color/vinor_pwa_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
